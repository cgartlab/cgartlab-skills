#!/usr/bin/env bash
# mock gh — test fixture for update-catalog.sh
#
# Behavior is driven by MOCK_MODE env var:
#   release_ok         : search returns 2 repos; both have releases
#   fallback_skill_md  : search returns 2 repos; one 404s on releases,
#                        has SKILL.md with metadata.version
#   no_skill_md        : search returns 1 repo; no release, no SKILL.md
#   api_error          : search endpoint fails (non-zero exit + stderr)
#
# Recognized calls:
#   gh api "search/repositories?q=..." [--paginate] [--jq ...]
#   gh api "/repos/<full>/releases/latest" [--jq ...]
#   gh api "/repos/<full>/contents/SKILL.md" --jq '.content'
set -uo pipefail

args=("$@")
subcmd="${args[0]:-}"

if [[ "$subcmd" != "api" ]]; then
  echo "mock gh: unsupported subcommand '$subcmd'" >&2
  exit 1
fi

endpoint="${args[1]:-}"

# --- search/repositories ---------------------------------------------------
if [[ "$endpoint" == search/repositories* ]]; then
  if [[ "${MOCK_MODE:-}" == "api_error" ]]; then
    echo "mock gh: simulated search failure" >&2
    exit 1
  fi

  case "${MOCK_MODE:-}" in
    release_ok)
      repos='[{"name":"alpha-skill","full_name":"cgartlab/alpha-skill","description":"Alpha test skill","updated_at":"2026-10-01T00:00:00Z","html_url":"https://github.com/cgartlab/alpha-skill"},{"name":"beta-skill","full_name":"cgartlab/beta-skill","description":"Beta test skill","updated_at":"2026-10-02T00:00:00Z","html_url":"https://github.com/cgartlab/beta-skill"}]'
      ;;
    fallback_skill_md)
      repos='[{"name":"alpha-skill","full_name":"cgartlab/alpha-skill","description":"Alpha test skill","updated_at":"2026-10-01T00:00:00Z","html_url":"https://github.com/cgartlab/alpha-skill"},{"name":"person-profile","full_name":"cgartlab/person-profile","description":"人物档案 skill","updated_at":"2026-10-05T00:00:00Z","html_url":"https://github.com/cgartlab/person-profile"}]'
      ;;
    no_skill_md)
      repos='[{"name":"gamma-skill","full_name":"cgartlab/gamma-skill","description":"Gamma test skill","updated_at":"2026-10-03T00:00:00Z","html_url":"https://github.com/cgartlab/gamma-skill"}]'
      ;;
    *)
      echo "mock gh: unknown MOCK_MODE '${MOCK_MODE:-}'" >&2
      exit 1
      ;;
  esac

  # Real gh applies --jq '[.items[] | select(...) | {...}]' to the response,
  # yielding an ARRAY of filtered repos. Emulate the post-filter shape.
  echo "$repos"
  exit 0
fi

# --- /repos/<full>/releases/latest ------------------------------------------
if [[ "$endpoint" == */releases/latest ]]; then
  if [[ "$endpoint" == *"person-profile"* || "$endpoint" == *"gamma-skill"* ]]; then
    # No release published: real API returns 404 + JSON error body
    echo '{"message":"Not Found","documentation_url":"https://docs.github.com/rest/releases/releases#get-the-latest-release","status":"404"}'
    exit 1
  fi
  echo '{"tag_name": "v0.3.0", "name": "v0.3.0"}'
  exit 0
fi

# --- /repos/<full>/contents/SKILL.md ----------------------------------------
if [[ "$endpoint" == */contents/SKILL.md ]]; then
  if [[ "$endpoint" == *"gamma-skill"* ]]; then
    # Real gh with --jq prints errors to STDERR and nothing to stdout on 404
    echo '{"message":"Not Found","status":"404"}' >&2
    exit 1
  fi
  # person-profile-style frontmatter with metadata.version
  skill_md=$(cat <<'YAML'
---
name: person-profile
description: test fixture skill
metadata:
  version: "0.1.1"
---
# Person Profile
YAML
)
  # base64 without line wrapping, as the contents API does
  # Script calls: gh api <endpoint> --jq '.content' — so real gh returns the
  # RAW base64 string (post --jq), not the {"content": ...} envelope.
  b64=$(printf '%s' "$skill_md" | base64 -w 0 2>/dev/null || printf '%s' "$skill_md" | base64)
  echo "$b64"
  exit 0
fi

echo "mock gh: unmocked endpoint '$endpoint'" >&2
exit 1
